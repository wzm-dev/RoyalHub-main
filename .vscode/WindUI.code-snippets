    // Place your RoyalHub workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
    // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
    // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
    // used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
    // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
    // Placeholders with the same ids are connected.
    // Example:
    // "Print to console": {
    // 	"scope": "javascript,typescript",
    // 	"prefix": "log",
    // 	"body": [
    // 		"console.log('$1');",
    // 		"$2"
    // 	],
    // 	"description": "Log output to console"
    // }
    //
    // You can also restrict snippets to specific files using include/exclude patterns:
    "WindUI Create Window Full": {
        "scope": "lua",
        "prefix": ":window",
        "body": [
            "local Window = WindUI:CreateWindow({",
            "    Title = \"$1\",",
            "    Author = \"$2\",",
            "    Folder = \"$3\",",
            "    Size = UDim2.fromOffset($4, $5),",
            "    Transparent = $6,",
            "    Theme = \"$7\",",
            "    SideBarWidth = $8,",
            "    $0",
            "})"
        ],
        "description": "Cria janela completa no WindUI"
    },
    "WindUI Create Tab": {
        "scope": "lua",
        "prefix": ":CTab",
        "body": [
            "local Tab = Window:Tab({",
            "    Title = \"$1\",",
            "    Icon = \"$2\",",
            "    Desc = \"$3\",",
            "    IconColor = \"Color3.fromRGB(255, 100, 100)\",",
            "    IconShape = \"$5\",",
            "    IconThemed = \"$6\",",
            "    Locked = \"$7\",",
            "    ShowTabTitle = \"$8\",",
            "    Border = \"$9\",",
            "})"
        ],
        "description": "Cria uma tab do WindUI"
    },
    "WindUI Create tab full": {
        "scope": "lua",
        "prefix": ":CTabFull",
        "body": [
            "local Tab = Window:Tab({",
            "    Title = \"${1:My Tab}\",",
            "    Desc = \"${2:Tab description}\",",
