    "WindUI Section": {
        "scope": "lua",
        "prefix": ":section",
        "body": [
            "local Section = Tab:Section({",
            "    Title = \"${1:General Settings}\",",
            "    Desc = \"${2:Section description}\",",
            "    Icon = \"${3:settings}\",",
            "    IconColor = Color3.fromRGB(${4:100}, ${5:100}, ${6:255}),",
            "    TextSize = ${7:19},",
            "    TextXAlignment = \"${8:Left}\",",
            "    Box = ${9:false},",
            "    BoxBorder = ${10:false},",
            "    Opened = ${11:true},",
            "    FontWeight = ${12:Enum.FontWeight.SemiBold},",
            "    DescFontWeight = ${13:Enum.FontWeight.Medium},",
            "    TextTransparency = ${14:0.05},",
            "    DescTextTransparency = ${15:0.4},",
            "    $0",
            "})"
        ],
        "description": "Cria uma section no WindUI"
    },
    "WindUI Button": {
        "scope": "lua",
        "prefix": ":buttn",
        "body": [
            "local Button = Tab:Button({",
            "    Title = \"${1:Click Me}\",",
            "    Desc = \"${2:Button description}\",",
            "    Icon = \"${3:mouse-pointer-click}\",",
            "    IconAlign = \"${4:Right}\",",
            "    Color = Color3.fromRGB(${5:100}, ${6:100}, ${7:255}),",
            "    Locked = ${8:false},",
            "    LockedTitle = \"${9:Locked}\",",
            "    Justify = \"${10:Between}\",",
            "    Flag = \"${11:my_button}\",",
            "    Callback = function()",
            "        ${0:print(\"Clicked!\")}",
            "    end",
            "})"
        ],
        "description": "Cria um botão no WindUI"
    },
