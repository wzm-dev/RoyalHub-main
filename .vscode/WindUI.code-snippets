            "    Desc = \"${2:Toggle description}\",",
            "    Icon = \"${3:power}\",",
            "    Value = ${4:false},",
            "    Type = \"${5:Toggle}\",",
            "    Color = Color3.fromRGB(${6:100}, ${7:200}, ${8:100}),",
            "    Locked = ${9:false},",
